{
  "name": "axi-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:databin && npm run build:admin && npm run build:promptTemplates && npm run build:exportChat && npm run build:providerSwitcher",
    "build:databin": "cross-env AXI_FEATURE=databin vite build",
    "build:admin": "cross-env AXI_FEATURE=admin vite build",
    "build:promptTemplates": "cross-env AXI_FEATURE=promptTemplates vite build",
    "build:exportChat": "cross-env AXI_FEATURE=exportChat vite build",
    "build:providerSwitcher": "cross-env AXI_FEATURE=providerSwitcher vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "^7.0.3",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  }
}
